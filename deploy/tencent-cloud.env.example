# =============================================================================
# K.H.A.V.I.S. 雲端主機與 Agent 集群環境變數配置 (Cloud & Fleet Configuration)
# =============================================================================
# 本設定檔整合主機上安裝之 5 大 CLI Agent 與 4 大 LLM 付費方案。
# 複製此檔案至根目錄並重命名為 `.env`：
#   cp deploy/tencent-cloud.env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 四大 LLM 付費方案金鑰 (LLM Paid Subscription Plans)
# -----------------------------------------------------------------------------
# [付費方案 1] MiniMax Token Plan
# 適用於: Claude Code (預設 MiniMax-M3.1-Flash), MiniMax Code CLI
MINIMAX_API_KEY=your_minimax_token_plan_api_key_here

# [付費方案 2] 智譜 GLM Coding Plan
# 適用於: OpenAI Codex (預設 glm-5.3-flashx), zcode CLI
ZHIPUAI_API_KEY=your_zhipu_glm_coding_plan_key_here
GLM_API_KEY=your_zhipu_glm_coding_plan_key_here

# [付費方案 3] OpenAI GPT GO Plan
# 適用於: GPT-4o, GPT-5-Codex, K.H.A.V.I.S. Planner / Judge
OPENAI_API_KEY=your_openai_gpt_go_api_key_here

# [付費方案 4] Google Antigravity AI Pro Plan (AGY)
# 適用於: Antigravity CLI (agy / antigravity-pro)
ANTIGRAVITY_API_KEY=your_antigravity_ai_pro_key_here
GOOGLE_API_KEY=your_antigravity_ai_pro_key_here

# -----------------------------------------------------------------------------
# 2. 五大 CLI Agent 調度與共用工作區設定 (Agent Fleet & Shared Workspace)
# -----------------------------------------------------------------------------
# 參與 /run 預設並行 Fan-out 的 Agent 清單 (用逗號隔開)
# 可選值: claude, codex, antigravity, minimax, zcode, khavis
BOT_BACKENDS=claude,codex,antigravity,minimax,zcode,khavis

# 各 CLI 單次任務執行超時時間 (秒)
BOT_BACKEND_TIMEOUT_S=180

# 共用專案工作區預設名稱與執行隔離模式 (shared 或 worktree)
KHAVIS_ACTIVE_PROJECT=shared-app
KHAVIS_ISOLATION_MODE=shared

# 各 CLI 預設指定之推論型號 (可於 /workbench 網頁動態調整)
CLAUDE_DISPATCH_MODEL=MiniMax-M3.1-Flash
CODEX_DISPATCH_MODEL=glm-5.3-flashx
ANTIGRAVITY_DISPATCH_MODEL=antigravity-pro
MINIMAX_DISPATCH_MODEL=MiniMax-M3.1
ZCODE_DISPATCH_MODEL=glm-5.3-flashx

# -----------------------------------------------------------------------------
# 3. 容錯調度、主動配額感知與 Webhook 告警 (High Availability & Alerting)
# -----------------------------------------------------------------------------
KHAVIS_FAILOVER=1
KHAVIS_LOCAL_FALLBACK=1
KHAVIS_WEBHOOK_URL=
KHAVIS_ALERT_COOLDOWN_S=300

# -----------------------------------------------------------------------------
# 4. 本地 Ollama 兜底節點
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FALLBACK_MODEL=gemma4:e2b
