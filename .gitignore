.mypy_cache/
.ruff_cache/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
*~

# Secrets — NEVER commit
.env
.env.*
!.env.example
deploy/.env
deploy/certs/*.pem

# Handoff & internal business/strategy notes — keep local, do not commit to public repo.
HANDOFF.local.md
docs/HANDOFF.md
BUSINESS_PLAN.md
RELEASE_CHECKLIST.md
docs/STRATEGY.md
docs/superpowers/
blog/

# Shared workspace & runtime outputs
workspace/
outputs/
config/custom_agents.json

# Project runtime data
memory/episodic.sqlite
memory/episodic.sqlite-journal
memory/semantic/*.sqlite3
memory/semantic/*.parquet
logs/*.jsonl
logs/*.log
# Per-request audit log (core/audit.py, default config/audit.jsonl)
config/audit.jsonl
config/audit.jsonl.*
# Chroma creates this when a store is opened against a literal ":memory:" name
:memory:.ses

# Build / packaging
*.bak
*.save
*.clobbered